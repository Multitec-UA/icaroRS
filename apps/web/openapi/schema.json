        "operationId": "list_rockets_api_rockets_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Rockets Api Rockets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Rockets",
        "tags": [
          "rockets"
        ]
      }
    },
    "/api/rockets/{rocket_id}": {
      "get": {
        "description": "Return the full rocket record including manifest and gcs_ref.\n\nThe ``manifest`` is the single source of truth in object storage\n(``parameters.json`` under the export prefix), NOT Firestore \u2014 it can\ncontain nested arrays that Firestore Native rejects (see\n``FirestoreDb.save_rocket``). It is loaded here from Storage and degrades to\n``{}`` if the blob is missing, so the endpoint never 500s on a stale record.\n\nReturns 404 if the rocket_id is not found OR not owned by the caller's org.\nSatisfies REQ-04.4.",
        "operationId": "get_rocket_api_rockets__rocket_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "rocket_id",
            "required": true,
            "schema": {
              "title": "Rocket Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Rocket Api Rockets  Rocket Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Rocket",
        "tags": [
          "rockets"
        ]
      }
    },
    "/api/scenario/template": {
      "get": {
        "description": "Return a starter Scenario dict with DEFAULT_UNCERTAINTY and PRESETS.\n\nThe UI uses this as its initial form state \u2014 it never starts empty.\nSatisfies AC-RG-2.3, RG-2.2.",
