    "schemas": {
      "Atmosphere": {
        "description": "Atmosphere model selection and fallback policy.\n\nParameters\n----------\nmodel : str\n    One of ``forecast``, ``wyoming_sounding``, ``standard_atmosphere``,\n    ``reanalysis``. Validated at load time (REQ-SCN-03).\nfile : str or None\n    For ``forecast``: GFS ensemble name (default ``\"GFS\"``).\n    For ``reanalysis``: path to a local ERA5-compatible .nc file (required\n    when model is ``reanalysis``, REQ-SCN-04).\nstation : str or None\n    Wyoming sounding station id. Required when model is\n    ``wyoming_sounding`` (REQ-SCN-05).\nfallback : str\n    Atmosphere model to use when the primary fetch fails.  Defaults to\n    ``\"standard_atmosphere\"`` (REQ-SCN-06).",
        "properties": {
          "fallback": {
            "default": "standard_atmosphere",
            "title": "Fallback",
            "type": "string"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "model": {
            "default": "standard_atmosphere",
            "title": "Model",
            "type": "string"
          },
          "station": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Station"
          }
        },
        "title": "Atmosphere",
        "type": "object"
      },
